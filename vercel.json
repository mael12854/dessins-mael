{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "specimens-mael.vercel.app" }],
      "destination": "https://dessins-mael.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

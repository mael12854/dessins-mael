---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Déposer src/assets/autoportrait.(png|jpg|webp) et src/assets/signature.(png|webp) pour remplacer les emplacements.
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const find = (name: string) => Object.entries(assets).find(([p]) => p.split('/').pop()!.startsWith(name + '.'))?.[1].default;
const portrait = find('autoportrait');
const signature = find('signature');
---
<Base title="À propos" active="apropos">
  <section class="pad prose" style="display:flex;flex-direction:column;gap:18px;padding-top:26px;">
    <span class="label red">Spécimen n°0</span>
    <h1 class="hand display">L’observateur</h1>
    <figure style="margin:0;display:flex;flex-direction:column;gap:8px;">
      <div class="portrait">
        <Sheet image={portrait} alt="Autoportrait dessiné, de dos, carnet à la main" ratio="r11" flat eager sizes="260px" />
      </div>
      <figcaption class="caption">autoportrait dessiné — de dos, carnet à la main</figcaption>
    </figure>
    <p>Je dessine les gens que je croise, sur le vif, au feutre noir. Je ne les dérange pas. Ils ne savent pas qu’ils font partie d’une collection.</p>
    <p>Bienvenue dans la collection. L’entrée est libre, il n’y a pas de gardien et on peut rester aussi longtemps qu’on veut. Pas de commentaires ici : regarde, souris si ça te dit, et repasse de temps en temps, de nouveaux spécimens arrivent régulièrement.</p>
    <div style="padding-top:12px;">
      {signature ? (
        <Image src={signature} alt="signature" class="signature-img" style="width:120px;height:44px;" width={240} format="webp" />
      ) : (
        <span class="signature-big" aria-hidden="true">signature dessinée</span>
      )}
    </div>
  </section>
</Base>

---
import '@fontsource-variable/shantell-sans/full.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/400-italic.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/courier-prime/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'collection' | 'apropos';
  noindex?: boolean;
}
const { title, description, active, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — Spécimens` : 'Spécimens — Observations dessinées d’humains en milieu naturel';
const desc = description ?? 'Spécimens : un blog BD. Observations dessinées au feutre noir d’humains en milieu naturel, à commencer par la vie des gens du métro.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spécimens" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="google-site-verification" content="s3pc8p1G-9SZ6fzlmzidcxkQnj3PspWIzmnsUIYNs2Y" />
    <meta name="theme-color" content="#FAF7F0" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Thème : choix mémorisé, sinon préférence du système. Avant le rendu pour éviter un flash.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <Header active={active} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          btn.setAttribute('aria-label', next === 'dark' ? 'Passer en mode jour' : 'Passer en mode nuit');
        });
      });
    </script>
  </body>
</html>

---
// Liste texte des spécimens (accueil tant qu'aucune planche n'a d'image).
import { pad, plancheUrl, seriesLabel, type Specimen } from '../lib/specimens';
interface Props { list: Specimen[] }
const { list } = Astro.props;
---
<ol class="speclist">
  {list.map((s) => (
    <li>
      <a href={plancheUrl(s.n)} class="speclist-item">
        <span class="speclist-num">N° {pad(s.n)}</span>
        <span class="speclist-body">
          <span class="hand speclist-title">{s.title}</span>
          <span class="meta">{seriesLabel(s.series)} · {s.pending ? 'en cours d’observation' : `obs. le ${s.date}`}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .speclist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .speclist li + li { border-top: 1px solid var(--line); }
  .speclist-item { display: flex; align-items: baseline; gap: 14px; padding: 14px 0; min-height: 44px; }
  .speclist-num {
    flex: none; padding: 2px 6px; background: var(--label); border: 1px solid var(--ink); transform: rotate(-3deg);
    font-family: var(--font-label); font-size: 11px; letter-spacing: .04em; color: var(--ink);
  }
  .speclist-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .speclist-title { font-weight: 700; font-variation-settings: 'BNCE' 50, 'INFM' 80; font-size: var(--fs-rubric); line-height: 1.15; }
  .speclist-item:hover .speclist-title { color: var(--red); }
</style>
